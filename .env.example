# Copiar a .env y completar. El archivo .env NO se versiona (está en .gitignore).
# Usar contraseñas propias: estas son solo marcadores.

DB_USER=postgres
DB_PASSWORD=completar-una-contraseña-larga

ACTIVEMQ_WEB_USER=admin
ACTIVEMQ_WEB_PASSWORD=completar-una-contraseña-larga

# Usuarios iniciales de la app (mínimo 8 caracteres).
LOGIRED_ADMIN_PASSWORD=completar-una-contraseña-larga
LOGIRED_OPERADOR_PASSWORD=completar-una-contraseña-larga

# Opcional. Para la demo del timeout usar http://ruteo-mock:8080/ruteo/lento
# LOGIRED_RUTEO_URL=http://ruteo-mock:8080/ruteo/optimizar

# Opcional: gateway de IA compatible con OpenAI. Vacío = respuesta de respaldo.
# LOGIRED_IA_GATEWAY_URL=
# LOGIRED_IA_API_KEY=

# Opcional: "demo" activa la generación automática de pedidos cada 2 minutos.
# SPRING_PROFILES_ACTIVE=demo
